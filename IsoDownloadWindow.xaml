<Window x:Class="Brennwerk.IsoDownloadWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Brennwerk · Original-ISO herunterladen" Width="1120" Height="900" MinWidth="900" MinHeight="760" Background="#10151F" Foreground="#EDF2FA" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" Closing="OnClosing">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="ORIGINAL-ISOS" Foreground="#6EE7C2" FontWeight="Bold"/><TextBlock Text="Windows und Linux direkt vom Anbieter." FontSize="27" FontWeight="SemiBold" Margin="0,6,0,18"/></StackPanel>
  <StackPanel Grid.Row="1" x:Name="Options">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="Provider" SelectedIndex="0" SelectionChanged="ProviderChanged"><ComboBoxItem Content="Windows 11 · Microsoft"/><ComboBoxItem Content="Ubuntu Desktop LTS · 64 Bit (Intel/AMD)"/><ComboBoxItem Content="Debian Netinstall · 64 Bit (Intel/AMD)"/><ComboBoxItem Content="Fedora Workstation · 64 Bit (Intel/AMD)"/></ComboBox><Button Grid.Column="1" x:Name="FindButton" Content="Aktuelle Version suchen" Click="FindLatest" Margin="12,0,0,0"/></Grid>
   <TextBlock x:Name="Description" Foreground="#9DAEC5" TextWrapping="Wrap" Margin="0,10,0,12"/>
   <StackPanel x:Name="WindowsOptions">
    <TextBlock Text="Microsoft-SHA-256 (optional, von der Microsoft-Seite übernehmen)" Margin="0,0,0,6"/><TextBox x:Name="ExpectedHash" FontSize="12"/>
    <Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="MicrosoftLink" ToolTip="Alternativ einen frischen Microsoft-ISO-Link einfügen" FontSize="12"/><Button Grid.Column="1" Content="Microsoft-Seite im Browser" Click="OpenMicrosoft" Margin="10,0,0,0"/></Grid>
   </StackPanel>
  </StackPanel>
  <Grid Grid.Row="2"><Border x:Name="BrowserBorder" BorderBrush="#3A4B63" BorderThickness="1"><ContentControl x:Name="BrowserSlot"/></Border><Border x:Name="LinuxInfo" Background="#1B2534" CornerRadius="8" Padding="24" Visibility="Collapsed"><StackPanel><TextBlock Text="Aktuelle stabile Veröffentlichung" Foreground="#6EE7C2" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ReleaseInfo" Text="Oben auf „Aktuelle Version suchen“ klicken." FontSize="20" Margin="0,16,0,14" TextWrapping="Wrap"/><TextBlock x:Name="SourceInfo" Foreground="#9DAEC5" TextWrapping="Wrap"/><TextBlock Text="Die offizielle SHA-256-Prüfsumme wird automatisch abgerufen und nach dem Download verglichen. Das ISO wird erst nach erfolgreicher Prüfung übernommen." TextWrapping="Wrap" Foreground="#C8D5E6" Margin="0,24,0,0"/></StackPanel></Border></Grid>
  <WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="DownloadButton" Content="ISO herunterladen …" Click="DownloadClick" Background="#147A64" IsEnabled="False"/><Button x:Name="CancelButton" Content="Download abbrechen" Click="Cancel" IsEnabled="False"/><TextBlock x:Name="Status" Foreground="#9DAEC5" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel>
  <ProgressBar x:Name="Progress" Grid.Row="4" Height="6" Margin="0,12,0,10" BorderThickness="0" Background="#243247" Foreground="#6EE7C2"/>
  <TextBox Grid.Row="5" x:Name="Log" Height="85" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12" Background="#0C1119"/>
 </Grid>
</Window>
